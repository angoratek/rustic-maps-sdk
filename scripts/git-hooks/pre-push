#!/bin/sh
# Pre-push verification gate: the three checks CI runs on every push (see
# .github/workflows/format-and-lint.yml), so a red CI run never surprises
# anyone. The gate fast-fails on the first failing step.
#
# The gate takes minutes, and a push that runs it holds the transport open
# until it finishes, which the remote may close first. Run the gate outside
# the push and the hook accepts the resulting stamp instead:
#
#     scripts/run-gate.sh
#     git push
#
# A stamp names the tree it checked, so a tree that never passed the gate is
# never accepted. A single push may still bypass it:
#
#     MAPS_SDK_SKIP_HOOKS=1 git push
#
# Install (repo-local, one-off): scripts/install-git-hooks
set -u

if [ -n "${MAPS_SDK_SKIP_HOOKS:-}" ]; then
    printf '%s\n' 'maps-sdk pre-push: MAPS_SDK_SKIP_HOOKS is set; skipping the verification gate.'
    exit 0
fi

stamp_directory=$(git rev-parse --git-path maps-sdk-gate-stamps)

pushed_tree_count=0
unstamped_tree_count=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in
        ''|*[!0]*) ;;
        *) continue ;;
    esac
    tree=$(git rev-parse --verify "$local_sha^{tree}" 2>/dev/null) || continue
    pushed_tree_count=$((pushed_tree_count + 1))
    if [ ! -f "$stamp_directory/$tree" ]; then
        unstamped_tree_count=$((unstamped_tree_count + 1))
    fi
done

if [ "$pushed_tree_count" -gt 0 ] && [ "$unstamped_tree_count" -eq 0 ]; then
    printf '%s\n' 'maps-sdk pre-push: a green gate stamp exists for every pushed tree; skipping the verification gate.'
    exit 0
fi

repository_root=$(git rev-parse --show-toplevel)
if ! "$repository_root/scripts/run-gate.sh"; then
    printf '\nmaps-sdk pre-push: the gate failed (output above). Fix it and push again, or bypass once with MAPS_SDK_SKIP_HOOKS=1.\n'
    exit 1
fi
