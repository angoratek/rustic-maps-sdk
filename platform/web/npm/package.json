{
  "name": "@angoratek/rustic-maps-sdk-web",
  "version": "0.1.0",
  "description": "Generated WebAssembly bindings for the Rustic Maps SDK (uniffi-bindgen-react-native wasm2 target).",
  "author": "angoratek",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/angoratek/rustic-maps-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angoratek/rustic-maps-sdk.git"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "dependencies": {
    "@ubjs/core": "0.31.0-6",
    "@ubjs/wasm": "0.31.0-6"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./rustic_maps": {
      "types": "./rustic_maps.d.ts",
      "default": "./rustic_maps.js"
    },
    "./rustic_maps_bg.js": {
      "types": "./rustic_maps_bg.d.ts",
      "default": "./rustic_maps_bg.js"
    },
    "./rustic_maps.wasm": "./rustic_maps.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "rustic_maps.js",
    "rustic_maps.d.ts",
    "rustic_maps-ffi.js",
    "rustic_maps-ffi.d.ts",
    "rustic_maps_bg.js",
    "rustic_maps_bg.d.ts",
    "rustic_maps.wasm",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "THIRD_PARTY_NOTICES.md"
  ]
}
