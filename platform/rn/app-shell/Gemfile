source 'https://rubygems.org'

# You may use http://rbenv.org/ or https://rvm.io/ to install and use this version
ruby ">= 2.6.10"

# Exclude problematic versions of cocoapods and activesupport that causes build failures.
# activesupport stays below 8 because every cocoapods-core release down to the
# 1.15 line pins `activesupport >= 5.0, < 8`; 7.2.3.1 is the newest release that
# resolves every advisory published for the 7.x line except the one that only
# an 8.x release fixes.
gem 'cocoapods', '>= 1.13', '!= 1.15.0', '!= 1.15.1'
gem 'activesupport', '>= 7.2.3.1', '< 8'
gem 'xcodeproj', '< 1.26.0'
# 1.3.7 fixes the lock and atomic-reference advisories; the old upper bound
# held CocoaPods below them.
gem 'concurrent-ruby', '>= 1.3.7'

# Ruby 3.4.0 has removed some libraries from the standard library.
gem 'bigdecimal'
gem 'logger'
gem 'benchmark'
gem 'mutex_m'
gem 'nkf'
