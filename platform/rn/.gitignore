# npm workspace dependencies.
node_modules/
/node_modules
# uniffi-bindgen-react-native compiles its CLI into this directory on first
# run.
target/

# The entries below are generated by scripts/build-rn.sh from the frozen UDL
# and the ubrn.config.yaml turbo-module config; committed inputs are
# package.json/package-lock.json, tsconfig.json, ubrn.config.yaml and
# react-native.config.js (the autolinking descriptor), plus the package's
# hand-written sources (src/MapView.tsx, src/MapsSdk.ts, the native
# module/view-manager classes in android/src/main/java/com/angoratek/rusticmaps, the
# pod's own ios/ sources, and the two Android files the generated build.gradle
# names unconditionally). The TurboModule glue (podspec, android/, ios/
# glue, cpp/ adapters, src/NativeRusticMapsSdk.ts, src/index.ts) is ubrn
# generator output and is rewritten on each `generate jsi turbo-module` run.
#
# The patterns are anchored to this package root on purpose: they name the
# TurboModule library's generated output, not the app-shell's, whose own
# src/, android/ and ios/ trees are app-owned sources (versioned here, with
# app-shell/.gitignore carrying the build outputs) — an unanchored
# `android/`/`src/` silently un-versioned the app shell (App.tsx imports
# src/* of its own) and blocked a fresh clone from building it.
# The generated binding sources (ubrn rewrites these). The package also ships
# hand-written sources beside them: `src/MapView.tsx`, `src/MapsSdk.ts`, the
# native module/view-manager classes under `android/src/main/java/com/angoratek/rusticmaps`
# and the pod's own `ios/` sources.
/src/generated/
/src/index.ts
/src/NativeRusticMapsSdk.ts
/cpp/
/android/.cxx/
/android/build/
/android/build.gradle
/android/CMakeLists.txt
/android/cpp-adapter.cpp
# `proguard-rules.pro` and `AndroidManifestNew.xml` stay versioned: the
# generated `build.gradle` names both unconditionally (`consumerProguardFiles`
# and `manifest.srcFile`), and ubrn only writes the first in some modes, so a
# fresh checkout without them cannot assemble the Android library. They are
# package sources, not build outputs.
/android/src/main/AndroidManifest.xml
/android/src/main/java/com/angoratek/rusticmaps/RusticMapsSdkModule.kt
/android/src/main/java/com/angoratek/rusticmaps/RusticMapsSdkPackage.kt
/android/src/main/jniLibs/
/ios/RusticMapsSdk.h
/ios/RusticMapsSdk.mm
# The staging directory `ubrn build ios --native-bindings` writes the FFI
# headers and a duplicate Swift binding into before assembling the
# xcframework; scripts/build-rn.sh removes it after a successful build.
/ios/swift/
/RusticMapsSdk.podspec
# The iOS binary archive the app pod vendors, produced by
# scripts/build-rn.sh's iOS stage (the platform/ios/artifacts/ equivalent);
# never committed.
/AngoratekRusticMapsSdkFramework.xcframework/
