{
  "name": "@angoratek/rustic-maps-sdk",
  "version": "0.1.0",
  "description": "React Native bindings for the Rustic Maps SDK, generated by uniffi-bindgen-react-native over the frozen UDL contract.",
  "author": "angoratek",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/angoratek/rustic-maps-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angoratek/rustic-maps-sdk.git"
  },
  "scripts": {
    "generate": "ubrn generate --config ubrn.config.yaml",
    "typecheck": "tsc --noEmit"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./MapView": "./src/MapView.tsx",
    "./MapsSdk": "./src/MapsSdk.ts",
    "./src/*": "./src/*"
  },
  "files": [
    "src",
    "cpp",
    "android",
    "android/src/main/jniLibs",
    "ios",
    "AngoratekRusticMapsSdkFramework.xcframework",
    "RusticMapsSdk.podspec",
    "react-native.config.js",
    "tsconfig.json",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "codegenConfig": {
    "name": "RusticMapsSdk",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.angoratek.rusticmaps"
    }
  },
  "dependencies": {
    "@ubjs/core": "0.31.0-6",
    "@babel/runtime": "^7.29.15",
    "uniffi-bindgen-react-native": "0.31.0-6"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.88.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "typescript": "5.9.3"
  }
}
