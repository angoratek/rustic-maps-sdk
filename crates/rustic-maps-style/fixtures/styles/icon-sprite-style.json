      "paint": {
        "text-color": "#1c1c1c",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#e8e4dc" }
