{
  "version": 8,
  "name": "POI labels fixture",
  "sprite": "fixture://icon-sprite",
  "sources": {
    "base": { "type": "vector" }
  },
  "layers": [
    {
      "id": "poi-labels",
      "type": "symbol",
      "source": "base",
      "source-layer": "poi",
      "filter": [
        "all",
        ["has", "name"],
        ["!=", ["get", "name"], ""]
      ],
      "layout": {
        "icon-image": [
          "match",
          ["get", "class"],
          ["bus"],
          "bus",
          ["railway"],
          "railway",
          ["park", "stadium", "garden"],
          "park",
          ["harbor", "marina"],
          "water",
          ""
        ],
        "icon-size": 1.0,
        "icon-anchor": "bottom",
        "icon-offset": [0, -0.4],
        "icon-padding": 2,
        "icon-allow-overlap": false,
        "icon-ignore-placement": false,
        "text-field": ["get", "name"],
        "text-size": 11,
        "text-anchor": "top",
        "text-offset": [0, 0.6],
        "text-allow-overlap": false,
        "text-ignore-placement": false,
        "symbol-sort-key": ["get", "rank"]
      },
      "paint": {
        "text-color": "#1c1c1c",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#e8e4dc" }
    }
  ]
}
