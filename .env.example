# MapQuest developer account credential (https://developer.mapquest.com/).
# Read by the fixture recorders in `crates/*/examples/record_*.rs` and by the
# capture runbooks in `docs/Release.md`; this is not the hosted demo's key.
# Copy this file to `.env` and paste your own key; `.env` is gitignored.
MAPQUEST_CONSUMER_KEY=

# Appetize API token for scripts/upload-demo-builds.mjs (a local run only; CI
# reads it from the repository secret of the same name). The name must match
# the variable the uploader reads, or a local upload refuses to run.
APPETIZE_TOKEN=

# The hosted demo's own provider credential (hosted-demo builds only; see
# docs/Providers.md (the hosted-demo exception)). Use a **dedicated**
# key issued for the demo — not the MAPQUEST_CONSUMER_KEY above, which records
# fixtures and runs the live smoke example — so an abusive build can be
# revoked without taking the tooling down with it. `scripts/inject-hosted-
# demo-credential.sh` writes it into the Android app on the build machine and
# `--clean` removes it again; CI reads the same names from the repository
# secret (and variable) below. Builds without it are keyless.
HOSTED_DEMO_PROVIDER_API_KEY=
HOSTED_DEMO_PROVIDER_KEY=mapquest
