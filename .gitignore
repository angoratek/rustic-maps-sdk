# Rust build artifacts
/target
/target-*/
**/target/
# Cargo.lock is tracked: the workspace ships packaged artifacts (AAR,
# XCFramework, wasm cdylib) and CI resolves --offline, so dependency
# versions must be pinned reproducibly.

# Scratch and prior research (superseded drafts)
tmp/

# Release assembly output (the release workflow uploads this tree)
/dist

# Agent worktrees (parallel rounds use isolated checkouts; never commit them)
.claude/worktrees/

# Editor and OS noise
*.swp
*.swo
.idea/
.vscode/
*.iml
.DS_Store

# Node tooling (RN platform packages)
node_modules/
# Kotlin Gradle plugin session state
.kotlin/

# API keys and local secrets — never commit; .env.example stays trackable
.env
.env.*
!.env.example

# Build-machine and signing material: SDK locations, keystores, provisioning
# profiles and local Xcode overrides. A distributed demo keystore comes from a
# repository secret on the build machine, never from the tree.
local.properties
*.jks
*.keystore
*.p12
*.mobileprovision
Local.xcconfig

# Test and profiling leftovers. A JVM heap dump is hundreds of megabytes and
# can carry process memory, so it is never a source artifact.
*.profraw
*.profdata
*.hprof
# Playwright + generated wasm bindings output
platform/web/pkg/
# The browser-loadable wasm2 package (scripts/build-wasm2-package.sh).
platform/web/generated/
# ubrn's bare default TypeScript output. The documented path generates the
# WebAssembly bindings with scripts/generate-wasm-bindings.sh into
# target/wasm-bindings; this directory only appears when ubrn runs without the
# project's output configuration.
platform/rn/src/generated/
test-results/
playwright-report/

# Refapp-only generated bindings and native libraries
# (scripts/build-refapp-core.sh). Never part of a published package.
platform/android/reference-application/src/refapp-core/generated/
platform/ios/reference-application/Generated/
